{
  "name": "web-sonify-monorepo",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "vitest run",
    "prepare": "husky",
    "build": "npm run build --workspaces && node scripts/post-build-inline.js",
    "bump:patch": "npm version patch --workspaces --include-workspace-root",
    "bump:minor": "npm version minor --workspaces --include-workspace-root"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  },
  "version": "0.1.0"
}
