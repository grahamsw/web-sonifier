{
  "name": "@web-sonifier/tone",
  "version": "0.1.3",
  "type": "module",
  "main": "./dist/ToneSonifier.cjs",
  "module": "./dist/ToneSonifier.js",
  "unpkg": "./dist/ToneSonifier.global.js",
  "exports": {
    ".": {
      "import": "./dist/ToneSonifier.js",
